   /**
+   * Tests a translated alias stored with the language prefix.
+   */
+  public function testNegotiationWithPrefixedAliasStoredInDatabase() {
+    $translated = $this->nodes[0]->getTranslation('ca');
+    $translated->set('path', '/ca/node--0--ca');
+    $translated->save();
+    \Drupal::service('path_alias.manager')->cacheClear();
+
+    $res = $this->drupalGet(
+      Url::fromRoute('decoupled_router.path_translation'),
+      [
+        'query' => [
+          'path' => $this->addBasePath('ca/node--0--ca'),
+          '_format' => 'json',
+        ],
+      ]
+    );
+    $this->assertSession()->statusCodeEquals(200);
+    $output = Json::decode($res);
+    $this->assertSame($this->nodes[0]->id(), $output['entity']['id']);
+    $this->assertSame('ca', $output['langcode']);
+  }
