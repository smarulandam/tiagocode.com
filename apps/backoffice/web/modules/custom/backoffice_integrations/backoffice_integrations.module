<?php

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;

/**
 * @file
 * Hooks for the Backoffice Integrations module.
 */

/**
 * Implements hook_cache_flush().
 */
function backoffice_integrations_cache_flush(): void {
  \Drupal::service('backoffice_integrations.website_cache_purger')->purgeWebsiteCache();
}

/**
 * Implements hook_entity_presave().
 */
function backoffice_integrations_entity_presave(EntityInterface $entity): void {
  \Drupal::service('backoffice_integrations.website_cache_node_invalidator')
    ->captureNodeUpdateState($entity);
}

/**
 * Implements hook_entity_update().
 */
function backoffice_integrations_entity_update(EntityInterface $entity): void {
  \Drupal::service('backoffice_integrations.website_cache_node_invalidator')
    ->invalidateUpdatedNode($entity);
}

/**
 * Implements hook_entity_predelete().
 */
function backoffice_integrations_entity_predelete(EntityInterface $entity): void {
  \Drupal::service('backoffice_integrations.website_cache_node_invalidator')
    ->captureNodeDeleteState($entity);
}

/**
 * Implements hook_entity_delete().
 */
function backoffice_integrations_entity_delete(EntityInterface $entity): void {
  \Drupal::service('backoffice_integrations.website_cache_node_invalidator')
    ->invalidateDeletedNode($entity);
}

/**
 * Implements hook_module_implements_alter().
 */
function backoffice_integrations_module_implements_alter(array &$implementations, string $hook): void {
  if ($hook !== 'entity_update' || !isset($implementations['backoffice_integrations'])) {
    return;
  }

  $group = $implementations['backoffice_integrations'];
  unset($implementations['backoffice_integrations']);
  $implementations['backoffice_integrations'] = $group;
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function backoffice_integrations_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  $github_login_url = Url::fromRoute('social_auth.network.redirect', ['network' => 'github']);
  $github_logo_path = base_path() . \Drupal::service('extension.list.module')->getPath('social_auth_github') . '/img/github_logo.svg';

  if (isset($form['captcha'])) {
    $form['captcha']['#weight'] = 97;
    $form['captcha']['#attributes']['class'][] = 'backoffice-login-captcha';
  }

  if (isset($form['actions'])) {
    $form['actions']['#weight'] = 98;
    $form['actions']['#attributes']['class'][] = 'backoffice-login-actions';
  }

  if (isset($form['more-links']['forgot_password_link'])) {
    $form['forgot_password_link'] = $form['more-links']['forgot_password_link'] + [
      '#weight' => 98.5,
    ];
    $form['forgot_password_link']['#attributes']['class'][] = 'backoffice-login-forgot';
    unset($form['more-links']['forgot_password_link']);
  }

  if (isset($form['more-links'])) {
    if (Element::children($form['more-links']) === []) {
      unset($form['more-links']);
    }
    else {
      $form['more-links']['#weight'] = 100;
      $form['more-links']['#attributes']['class'][] = 'backoffice-login-links';
    }
  }

  $form['github_login'] = [
    '#type' => 'container',
    '#weight' => 99,
    '#attributes' => [
      'class' => [
        'backoffice-social-login',
      ],
    ],
    'label' => [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#value' => t('Or continue with'),
      '#attributes' => [
        'class' => ['backoffice-social-login__label'],
      ],
    ],
    'link' => [
      '#type' => 'link',
      '#title' => [
        '#type' => 'inline_template',
        '#template' => '<img src="{{ src }}" alt="" width="32" height="32" loading="lazy" decoding="async" />',
        '#context' => [
          'src' => $github_logo_path,
        ],
      ],
      '#url' => $github_login_url,
      '#attributes' => [
        'class' => [
          'backoffice-social-login__card',
        ],
        'aria-label' => t('Continue with GitHub'),
        'title' => t('Continue with GitHub'),
      ],
    ],
  ];

  $form['#attached']['library'][] = 'backoffice_integrations/social_login';
}
